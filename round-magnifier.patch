+		/// <summary>
+		/// A round lens: drop shadow, a metal-look rim (glass style) or thin rim (simple
+		/// style), then the magnified picture clipped to a circle. Everything is a polygon of
+		/// many short sides, which at this size is indistinguishable from a true circle.
+		/// </summary>
+		private void RenderRoundMagnifier(IBitmapRenderer renderer, IGeometryClipRenderer clipper)
+		{
+			bool glass = MagnifierStyle == MagnifierStyle.Glass;
+			float opacity = MagnifierOpacity.Clamp(0f, 1f);
+			Rectangle client = magnifierOverlay.ClientRectangle;
+			float diameter = Math.Min(client.Width, client.Height);
+			float margin = glass ? 4f : 3f;
+			float rim = glass ? Math.Max(6f, diameter * 0.045f) : 3f;
+			RectangleF outer = new RectangleF((float)client.X + ((float)client.Width - diameter) / 2f + margin, (float)client.Y + ((float)client.Height - diameter) / 2f + margin, diameter - margin * 2f, diameter - margin * 2f);
+			RectangleF lens = outer;
+			lens.Inflate(0f - rim, 0f - rim);
+			if (lens.Width < 8f)
+			{
+				return;
+			}
+
+			PointF[] shadow = CirclePolygon(renderer, new RectangleF(outer.X + 1.5f, outer.Y + 3f, outer.Width, outer.Height));
+			PointF[] outline = CirclePolygon(renderer, outer);
+			RectangleF edge = lens;
+			edge.Inflate(1.5f, 1.5f);
+			PointF[] lensEdge = CirclePolygon(renderer, edge);
+			PointF[] lensShape = CirclePolygon(renderer, lens);
+
+			clipper.FillPolygon(shadow, Color.FromArgb((int)(70f * opacity), 0, 0, 0));
+			if (glass)
+			{
+				clipper.FillPolygonGradient(outline, ToDevice(renderer, outer.Left, outer.Top), Color.FromArgb((int)(255f * opacity), 236, 238, 242), ToDevice(renderer, outer.Right, outer.Bottom), Color.FromArgb((int)(255f * opacity), 92, 98, 108));
+			}
+			else
+			{
+				clipper.FillPolygon(outline, Color.FromArgb((int)(235f * opacity), 70, 74, 82));
+			}
+			//A dark hairline where the rim meets the glass.
+			clipper.FillPolygon(lensEdge, Color.FromArgb((int)(200f * opacity), 30, 32, 38));
+
+			Rectangle content = Rectangle.Round(lens);
+			Point location = magnifierOverlay.Location;
+			location.Offset(content.Location);
+			location.Offset(content.Width / 2, content.Height / 2);
+			location = location.Clip(base.ClientRectangle);
+			float zoom = MagnifierZoom;
+
+			clipper.PushPolygonClip(lensShape);
+			try
+			{
+				renderer.Opacity = opacity;
+				RectangleF clip = renderer.Clip;
+				DrawMagnifier(renderer, location, content, zoom);
+				renderer.Clip = clip;
+				renderer.Opacity = 1f;
+				if (glass)
+				{
+					//A soft reflection across the top of the glass.
+					RectangleF cap = new RectangleF(lens.X, lens.Y, lens.Width, lens.Height * 0.45f);
+					PointF[] capShape = new PointF[4]
+					{
+						ToDevice(renderer, cap.Left, cap.Top),
+						ToDevice(renderer, cap.Right, cap.Top),
+						ToDevice(renderer, cap.Right, cap.Bottom),
+						ToDevice(renderer, cap.Left, cap.Bottom)
+					};
+					clipper.FillPolygonGradient(capShape, capShape[0], Color.FromArgb((int)(60f * opacity), 255, 255, 255), capShape[3], Color.FromArgb(0, 255, 255, 255));
+				}
+			}
+			finally
+			{
+				clipper.PopPolygonClip();
+			}
+		}
+
+		private static PointF ToDevice(IBitmapRenderer renderer, float x, float y)
+		{
+			PointF[] pts = new PointF[1]
+			{
+				new PointF(x, y)
+			};
+			using (Matrix m = renderer.Transform)
+			{
+				m.TransformPoints(pts);
+			}
+			return pts[0];
+		}
+
+		/// <summary>
+		/// A circle (or ellipse) inscribed in the rectangle, as a polygon in device space
+		/// - what IGeometryClipRenderer expects - from panel coordinates.
+		/// </summary>
+		private static PointF[] CirclePolygon(IBitmapRenderer renderer, RectangleF bounds)
+		{
+			const int Sides = 120;
+			PointF[] pts = new PointF[Sides];
+			float cx = bounds.X + bounds.Width / 2f;
+			float cy = bounds.Y + bounds.Height / 2f;
+			float rx = bounds.Width / 2f;
+			float ry = bounds.Height / 2f;
+			for (int i = 0; i < Sides; i++)
+			{
+				double a = Math.PI * 2.0 * (double)i / (double)Sides;
+				pts[i] = new PointF(cx + rx * (float)Math.Cos(a), cy + ry * (float)Math.Sin(a));
+			}
+			using (Matrix m = renderer.Transform)
+			{
+				m.TransformPoints(pts);
+			}
+			return pts;
 		}
 
