+			{
+				return;
+			}
+			string text = null;
+			PageTranslationService service = pageTranslator;
+			if (translatePages && service != null && IsValid)
+			{
+				string problem = service.Status;
+				if (!string.IsNullOrEmpty(problem))
+				{
+					text = problem;
